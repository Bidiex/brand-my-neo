---
import { getLang } from '../i18n.js';

const faqsEs = [
  { q: '¿Esto es real?', a: 'Sí. Compro la MacBook Neo Blush con lo recaudado, y cada logo aprobado se imprime como sticker y se pega en la tapa real.' },
  { q: '¿Por qué esta laptop?', a: 'Ya soy profesional y quiero seguir formándome con cursos de análisis de datos, metodologías ágiles, Scrum y gestión de proyectos. Para hacerlo bien necesito un computador propio, y la MacBook Neo en Blush es la que llevo tiempo mirando.' },
  { q: '¿Qué recibo?', a: 'Tu logo como sticker físico en la tapa y un espacio en esta página con enlace a tu sitio o red social.' },
  { q: '¿Cómo pago?', a: 'Por Bre-B, el sistema de pagos inmediatos del Banco de la República, a precio fijo. Transfieres desde la app de cualquier banco o billetera a mi llave (mi celular) y el dinero llega en segundos. Luego envías el formulario con el comprobante y tu logo.' },
  { q: '¿Hay reembolsos?', a: 'Los pagos por Bre-B no se reembolsan automáticamente. Si hay un problema con tu reserva, escríbeme y lo resolvemos caso a caso.' },
  { q: '¿Aceptas cualquier logo?', a: 'Cada logo se aprueba manualmente. Me reservo el derecho de rechazar contenido ofensivo o inapropiado; en ese caso te contacto para cambiarlo o devolver el pago.' },
];
const faqsEn = [
  { q: 'Is this real?', a: 'Yes. I buy the MacBook Neo in Blush with the money raised, and every approved logo is printed as a sticker and placed on the real lid.' },
  { q: 'Why this laptop?', a: 'I’m already a professional and I want to keep learning through courses in data analysis, agile methodologies, Scrum and project management. To do that well I need a computer of my own, and the MacBook Neo in Blush is the one I’ve had my eye on for a while.' },
  { q: 'What do I get?', a: 'Your logo as a physical sticker on the lid, plus a spot on this page linking to your site or social profile.' },
  { q: 'How do I pay?', a: 'With Bre-B, Colombia’s instant payment system run by the central bank, at a fixed price in Colombian pesos (COP). You transfer from any Colombian bank or wallet app to my key (my phone number) and the money arrives in seconds. Prices in USD are approximate. Then you submit the form with the receipt and your logo.' },
  { q: 'Are there refunds?', a: 'Bre-B payments are not refunded automatically. If there’s a problem with your reservation, message me and we’ll sort it out case by case.' },
  { q: 'Do you accept any logo?', a: 'Every logo is approved manually. I reserve the right to reject offensive or inappropriate content; in that case I’ll contact you to change it or return your payment.' },
];
const lang = getLang(Astro);
const faqs = lang === 'en' ? faqsEn : faqsEs;
---
<section class="section" id="faq">
  <div class="container faq">
    <h2 class="section-title center">{lang === 'en' ? 'Frequently asked questions.' : 'Preguntas frecuentes.'}</h2>
    <div class="faq__list">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__list { max-width: 720px; margin: 36px auto 0; }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 16px 0; font-size: 16px; font-weight: 600; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--rose); font-weight: 400; font-size: 22px; line-height: 1; }
  details[open] summary::after { content: '−'; }
  details p { margin: 0 0 16px; color: var(--text-2); }
</style>

---
import { asset } from '../data/proyecto.js';
import { getLang } from '../i18n.js';

const lang = getLang(Astro);
const t = {
  es: {
    eyebrow: 'Ya la conocí',
    title: 'La vi, la probé<br />y ahora es la meta 😍',
    lead: 'Fui a la tienda a verla en persona. Spoiler: el rosa es más bonito de cerca.',
    open: 'Ampliar foto',
    close: 'Cerrar',
    fotos: [
      'Primer encuentro',
      'Probando el teclado',
      'Brand My Neo, escrito en ella',
      'Ese rosa, no otro',
    ],
  },
  en: {
    eyebrow: 'We’ve met',
    title: 'I saw it, I tried it,<br />now it’s the goal 😍',
    lead: 'I went to the store to see it in person. Spoiler: the pink is prettier up close.',
    open: 'Enlarge photo',
    close: 'Close',
    fotos: [
      'First encounter',
      'Testing the keyboard',
      'Brand My Neo, typed on it',
      'That pink, no other',
    ],
  },
}[lang];

// Las variantes de 800 y 1600 px salen de public/img/IMG1-4.webp (redimensionadas con sharp)
const fotos = t.fotos.map((caption, i) => ({
  caption,
  src: asset(`/img/galeria/silenia-${i + 1}-800.webp`),
  srcset: [800, 1600].map((w) => `${asset(`/img/galeria/silenia-${i + 1}-${w}.webp`)} ${w}w`).join(', '),
}));
---
<section class="section galeria-section" id="galeria">
  <div class="container">
    <div class="center">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="section-title" set:html={t.title} />
      <p class="section-lead">{t.lead}</p>
    </div>

    <ul class="galeria">
      {fotos.map((f, i) => (
        <li class="galeria__item">
          <figure class="galeria__card">
            <button class="galeria__foto" type="button" aria-label={`${t.open}: ${f.caption}`} data-index={i}>
              <img src={f.src} srcset={f.srcset} sizes="(max-width: 834px) 68vw, 240px" width="800" height="1067" alt={`Silenia Camargo — ${f.caption}`} loading="lazy" decoding="async" />
            </button>
          </figure>
        </li>
      ))}
    </ul>
  </div>

  <div class="lightbox" role="dialog" aria-modal="true" aria-label={t.eyebrow} hidden>
    <div class="lightbox__bg"></div>
    <div class="lightbox__stage"></div>
    <button class="lightbox__close" type="button" aria-label={t.close}>✕</button>
  </div>
</section>

<style>
  .galeria-section { overflow: hidden; }
  .galeria {
    position: relative; list-style: none; margin: 56px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
    align-items: start;
  }
  /* Escalonado tipo collage: las columnas pares bajan un poco */
  .galeria__item:nth-child(even) { margin-top: 48px; }
  .galeria__card { margin: 0; }
  .galeria__foto {
    display: block; width: 100%; aspect-ratio: 3 / 4; padding: 0; border: 0;
    border-radius: 22px; overflow: hidden; cursor: zoom-in;
    background: var(--blush);
    box-shadow: 0 18px 40px -18px rgba(120, 40, 60, .45);
    transition: transform .4s cubic-bezier(.2, .8, .2, 1), box-shadow .4s;
  }
  .galeria__foto:hover { transform: translateY(-8px) rotate(-1deg); box-shadow: 0 28px 50px -20px rgba(120, 40, 60, .55); }
  .galeria__foto:focus-visible { outline: 3px solid var(--rose); outline-offset: 4px; }
  .galeria__foto img { width: 100%; height: 100%; object-fit: cover; }

  .lightbox { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; }
  .lightbox[hidden] { display: none; }
  .lightbox__bg { position: absolute; inset: 0; background: rgba(29, 12, 18, .82); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .lightbox__stage { position: relative; display: grid; place-items: center; width: min(92vw, calc(80vh * .75)); aspect-ratio: 3 / 4; }
  .lightbox__stage img { width: 100%; height: 100%; object-fit: cover; border-radius: 22px; cursor: zoom-out; }
  .lightbox__close {
    position: absolute; top: 16px; right: 16px; width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: rgba(255, 255, 255, .16); color: #fff; font-size: 18px; cursor: pointer;
  }
  .lightbox__close:hover { background: rgba(255, 255, 255, .28); }

  @media (max-width: 834px) {
    /* Móvil: una sola fila horizontal. Con GSAP se fija la sección y la fila corre con el scroll
       (ver galeria() en animations.ts); sin animaciones queda como carrusel deslizable con el dedo */
    .galeria {
      display: flex; gap: 14px; margin: 40px -22px 0; padding: 0 22px 12px;
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    }
    .galeria::-webkit-scrollbar { display: none; }
    .galeria__item { flex: 0 0 68vw; max-width: 320px; scroll-snap-align: center; }
    .galeria__item:nth-child(even) { margin-top: 28px; }
  }
</style>

<script>
  // Lightbox: la foto "vuela" de la cuadrícula al centro con GSAP Flip y regresa al cerrar
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';

  gsap.registerPlugin(Flip);

  const box = document.querySelector<HTMLElement>('.lightbox');
  const stage = box?.querySelector<HTMLElement>('.lightbox__stage');
  const bg = box?.querySelector<HTMLElement>('.lightbox__bg');
  const closeBtn = box?.querySelector<HTMLButtonElement>('.lightbox__close');
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  let current: { img: HTMLImageElement; home: HTMLButtonElement } | null = null;

  function open(home: HTMLButtonElement) {
    if (!box || !stage || current) return;
    const img = home.querySelector('img')!;
    const state = Flip.getState(img);
    box.hidden = false;
    document.body.style.overflow = 'hidden';
    img.sizes = '92vw';
    stage.appendChild(img);
    current = { img, home };
    const d = reduce() ? 0 : 1;
    Flip.from(state, { duration: 0.7 * d, ease: 'power3.inOut', zIndex: 2 });
    gsap.fromTo(bg, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.4 * d });
    gsap.fromTo(closeBtn, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.4 * d, delay: 0.35 * d });
    closeBtn!.focus({ preventScroll: true });
  }

  function close() {
    if (!box || !current) return;
    const { img, home } = current;
    current = null;
    const d = reduce() ? 0 : 1;
    gsap.to(closeBtn, { autoAlpha: 0, duration: 0.2 * d });
    gsap.to(bg, { autoAlpha: 0, duration: 0.5 * d });
    // Vuela de vuelta encima de su hueco sin salir del overlay (el botón recortaría la foto con overflow)
    Flip.fit(img, home, {
      duration: 0.6 * d, ease: 'power3.inOut',
      onComplete: () => {
        home.appendChild(img);
        gsap.set(img, { clearProps: 'all' });
        img.sizes = '(max-width: 834px) 68vw, 240px';
        box.hidden = true;
        document.body.style.overflow = '';
        home.focus({ preventScroll: true });
      },
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.galeria__foto').forEach((b) => b.addEventListener('click', () => open(b)));
  box?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>

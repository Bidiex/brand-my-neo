---
import { meta, recaudado, porcentaje, vendidos, spots, cop } from '../data/proyecto.js';
---
<section class="hero" id="top">
  <div class="container center">
    <p class="hero__stats">
      <b>{vendidos.length}/{spots.length}</b> spots vendidos<i>•</i><b>{spots.length - vendidos.length}</b> disponibles<i>•</i>Meta <b>{cop(meta)}</b> COP
    </p>
    <h1 class="hero__title">Ella quiere empezar<br />a estudiar.</h1>
    <p class="section-lead hero__lead">
      Le estoy comprando a Silenia su primera MacBook vendiendo espacios de sticker en la tapa. Consigue el tuyo.
    </p>

    <div class="progress" aria-label="Progreso de la recaudación">
      <div class="progress__row">
        <p class="progress__raised"><strong>{cop(recaudado)}</strong> recaudados</p>
        <p class="progress__goal">meta {cop(meta)} · <b>{porcentaje}%</b></p>
      </div>
      <div class="progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={porcentaje}>
        <div class="progress__fill" style={`width:${porcentaje}%`}></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding: 64px 0 0; }
  .hero__stats { margin: 0 0 14px; font-size: 13px; color: var(--text-2); }
  .hero__stats b { color: var(--text); font-weight: 600; }
  .hero__stats i { font-style: normal; margin: 0 8px; opacity: .5; }
  .hero__title { font-size: clamp(32px, 5.2vw, 56px); letter-spacing: -0.04em; }

  .progress { max-width: 400px; margin: 28px auto 0; }
  .progress__row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .progress__row p { margin: 0; font-size: 13px; color: var(--text-2); }
  .progress__raised strong { font-size: 24px; letter-spacing: -0.03em; color: var(--rose); margin-right: 4px; }
  .progress__goal b { color: var(--rose); font-weight: 600; }
  .progress__bar { height: 6px; margin-top: 8px; background: var(--blush-soft); border-radius: 99px; overflow: hidden; }
  .progress__fill { height: 100%; min-width: 6px; background: var(--rose); border-radius: 99px; }
</style>

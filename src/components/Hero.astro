---
import Perfil from './Perfil.astro';
import Money from './Money.astro';
import { meta, recaudado, porcentaje, vendidos, spots } from '../data/proyecto.js';
import { getLang } from '../i18n.js';

const t = {
  es: {
    sold: 'spots vendidos', available: 'disponibles', goal: 'Meta',
    title: 'Quiero seguir<br />aprendiendo.',
    lead: 'Estoy financiando mi primera MacBook vendiendo espacios de sticker en su tapa. Consigue el tuyo.',
    progress: 'Progreso de la recaudación', raised: 'recaudados', of: 'de',
  },
  en: {
    sold: 'spots sold', available: 'available', goal: 'Goal',
    title: 'I want to keep<br />learning.',
    lead: 'I’m funding my first MacBook by selling sticker spots on its lid. Get yours.',
    progress: 'Fundraising progress', raised: 'raised', of: 'of',
  },
}[getLang(Astro)];
---
<section class="hero" id="top">
  <div class="container center">
    <p class="hero__stats">
      <b>{vendidos.length}/{spots.length}</b> {t.sold}<i>•</i><b>{spots.length - vendidos.length}</b> {t.available}<i>•</i>{t.goal} <b><Money value={meta} code /></b>
    </p>
    <h1 class="hero__title" set:html={t.title} />
    <p class="section-lead hero__lead">
      {t.lead}
    </p>

    <div class="progress" aria-label={t.progress}>
      <div class="progress__row">
        <p class="progress__raised"><strong><Money value={recaudado} /></strong> {t.raised}</p>
        <p class="progress__goal">{t.of} <Money value={meta} code /><span>·</span><b>{porcentaje}%</b></p>
      </div>
      <div class="progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={porcentaje}>
        <div class="progress__fill" style={`width:${porcentaje}%`}></div>
      </div>
    </div>

    <Perfil />
  </div>
</section>

<style>
  .hero { padding: 64px 0 0; }
  .hero__stats { margin: 0 0 14px; font-size: 13px; color: var(--text-2); }
  .hero__stats b { color: var(--text); font-weight: 600; }
  .hero__stats i { font-style: normal; margin: 0 8px; opacity: .5; }
  .hero__title { font-size: clamp(32px, 5.2vw, 56px); letter-spacing: -0.04em; }

  .progress { max-width: 440px; margin: 32px auto 0; }
  .progress__row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .progress__row p { margin: 0; font-size: 15px; color: var(--text-2); }
  .progress__raised strong {
    font-size: 30px; font-weight: 700; letter-spacing: -0.035em; line-height: 1;
    color: var(--rose); margin-right: 6px; font-variant-numeric: tabular-nums;
  }
  .progress__goal span { margin: 0 6px; color: var(--line); }
  .progress__goal b { color: var(--rose); font-weight: 600; }
  .progress__bar {
    height: 10px; margin-top: 12px; border-radius: 99px; overflow: hidden;
    background: #ebebef;
  }
  .progress__fill {
    height: 100%; border-radius: 99px;
    background: linear-gradient(90deg, #d98a9c, var(--rose));
  }
</style>

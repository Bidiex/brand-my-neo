---
import fs from 'node:fs';
import Perfil from './Perfil.astro';
import Money from './Money.astro';
import { asset, meta } from '../data/proyecto.js';
import { getLang } from '../i18n.js';

const lang = getLang(Astro);
const t = {
  es: {
    eyebrow: 'Por qué esto',
    title: 'Su primer Mac.<br />Tu marca en la tapa.',
    p1: 'Silenia está por empezar su carrera y todavía no tiene un computador propio. Hace tiempo eligió el suyo: una MacBook Neo en Blush. Ese rosa, no otro. Y quiero ser yo quien se la regale.',
    p2: 'Solo no me alcanza. Así que convertí la tapa en espacio de marca: diez stickers, diez auspiciadores. Tu logo va con ella a cada clase, cada sesión de estudio y cada foto que suba.',
    p3a: 'La meta es', p3b: ', y cada spot paga una parte real del equipo. Cuando se vendan los diez, Silenia abre su primer Mac — con tu marca en la tapa, como parte de cómo empezó.',
    altProduct: 'MacBook Neo Blush abierta mostrando apps de estudio',
  },
  en: {
    eyebrow: 'Why this',
    title: 'Her first Mac.<br />Your brand on the lid.',
    p1: 'Silenia is about to start her degree and still doesn’t have a computer of her own. She picked hers a while ago: a MacBook Neo in Blush. That pink, no other. And I want to be the one who gives it to her.',
    p2: 'I can’t afford it on my own. So I turned the lid into brand space: ten stickers, ten sponsors. Your logo goes with her to every class, every study session and every photo she posts.',
    p3a: 'The goal is', p3b: ', and every spot pays for a real part of the laptop. Once all ten are sold, Silenia opens her first Mac — with your brand on the lid, as part of how it all started.',
    altProduct: 'MacBook Neo in Blush, open and showing study apps',
  },
}[lang];

// Coloca la foto en public/img/silenia.png (o .jpg) y aparecerá automáticamente.
const fotoSilenia = ['silenia.png', 'silenia.jpg'].find((f) => fs.existsSync(new URL(`../../public/img/${f}`, import.meta.url)));
---
<section class="section" id="historia">
  <div class="container historia">
    <div class="historia__media">
      {fotoSilenia ? (
        <img src={asset(`/img/${fotoSilenia}`)} alt="Silenia Camargo" loading="lazy" />
      ) : (
        <img class="is-product" src={asset("/img/neo-lifestyle.png")} width="1369" height="965" alt={t.altProduct} loading="lazy" />
      )}
    </div>
    <div class="historia__text">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="section-title" set:html={t.title} />
      <p>{t.p1}</p>
      <p>{t.p2}</p>
      <p>{t.p3a} <Money value={meta} code />{t.p3b}</p>
      <Perfil variant="card" />
    </div>
  </div>
</section>

<style>
  .historia { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .historia__media img { width: 100%; height: auto; object-fit: contain; border-radius: 28px; background: transparent; }
  .historia__text .section-title { margin-bottom: 18px; }
  .historia__text p { font-size: 16px; color: var(--text-2); margin: 0 0 14px; }
  .historia__text p:first-of-type { color: var(--text); }
  @media (max-width: 834px) {
    .historia { grid-template-columns: 1fr; gap: 40px; }
  }
</style>

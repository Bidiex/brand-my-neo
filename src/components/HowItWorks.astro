---
import { NEQUI } from '../data/proyecto.js';

const pasos = [
  { n: '01', titulo: 'Elige tu spot', texto: 'Escoge un espacio libre en la tapa. Cada fila tiene su precio fijo: sin pujas, sin sorpresas.' },
  { n: '02', titulo: 'Paga por Nequi', texto: `Transfiere el valor del spot al ${NEQUI} y envía el formulario con el comprobante y tu logo.` },
  { n: '03', titulo: 'Tu sticker, en la tapa', texto: 'Confirmo el pago, imprimo tu logo como sticker y lo pego en la MacBook Neo de Silenia. También aparece aquí, con link a tu sitio.' },
];
---
<section class="section section--alt" id="como-funciona">
  <div class="container">
    <div class="center">
      <span class="eyebrow">Cómo funciona</span>
      <h2 class="section-title">Tres pasos. Así de simple.</h2>
    </div>
    <ol class="pasos">
      {pasos.map((p) => (
        <li class="paso">
          <span class="paso__n">{p.n}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pasos {
    list-style: none; padding: 0; margin: 56px 0 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
  }
  .paso { background: #fff; border-radius: 24px; padding: 32px 28px; }
  .paso__n { display: block; font-size: 44px; font-weight: 700; letter-spacing: -0.04em; color: var(--blush); line-height: 1; margin-bottom: 22px; }
  .paso h3 { font-size: 24px; }
  .paso p { color: var(--text-2); margin: 12px 0 0; }
  @media (max-width: 834px) { .pasos { grid-template-columns: 1fr; } }
</style>

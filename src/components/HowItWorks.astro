---
import { NEQUI } from '../data/proyecto.js';
import { getLang } from '../i18n.js';

const t = {
  es: {
    eyebrow: 'Cómo funciona', title: 'Tres pasos. Así de simple.',
    pasos: [
      ['Elige tu spot', 'Escoge un espacio libre en la tapa. Cada fila tiene su precio fijo: sin pujas, sin sorpresas.'],
      ['Paga por Nequi', `Transfiere el valor del spot al ${NEQUI} y envía el formulario con el comprobante y tu logo.`],
      ['Tu sticker, en la tapa', 'Confirmo el pago, imprimo tu logo como sticker y lo pego en la MacBook Neo de Silenia. También aparece aquí, con link a tu sitio.'],
    ],
  },
  en: {
    eyebrow: 'How it works', title: 'Three steps. That simple.',
    pasos: [
      ['Pick your spot', 'Choose a free spot on the lid. Each row has a fixed price: no bidding, no surprises.'],
      ['Pay with Nequi', `Send the spot price in Colombian pesos to Nequi ${NEQUI} (a Colombian payment app) and submit the form with the receipt and your logo.`],
      ['Your sticker, on the lid', 'I confirm the payment, print your logo as a sticker and put it on Silenia’s MacBook Neo. It also shows up here, linking to your site.'],
    ],
  },
}[getLang(Astro)];
const pasos = t.pasos.map(([titulo, texto], i) => ({ n: `0${i + 1}`, titulo, texto }));
---
<section class="section" id="como-funciona">
  <div class="container">
    <div class="center">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="section-title">{t.title}</h2>
    </div>
    <ol class="pasos">
      {pasos.map((p) => (
        <li class="paso">
          <span class="paso__n">{p.n}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pasos {
    list-style: none; padding: 0; margin: 40px 0 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
  }
  .paso { background: var(--bg-alt); border-radius: 24px; padding: 32px 28px; }
  .paso__n { display: block; font-size: 32px; font-weight: 700; letter-spacing: -0.04em; color: var(--blush); line-height: 1; margin-bottom: 14px; }
  .paso h3 { font-size: 19px; }
  .paso p { color: var(--text-2); margin: 8px 0 0; }
  @media (max-width: 834px) { .pasos { grid-template-columns: 1fr; } }
</style>

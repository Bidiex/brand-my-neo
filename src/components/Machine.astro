---
import { asset } from '../data/proyecto.js';
import { getLang } from '../i18n.js';

const lang = getLang(Astro);
const specsEs = [
  { k: 'Chip', v: 'Apple A18 Pro', d: 'CPU de 6 núcleos, GPU de 5 núcleos, Neural Engine de 16 núcleos.' },
  { k: 'Pantalla', v: 'Liquid Retina 13"', d: '2408 × 1506, 500 nits, recubrimiento antirreflejo.' },
  { k: 'Batería', v: 'Hasta 16 horas', d: 'Un día entero de clases sin buscar enchufe.' },
  { k: 'Memoria', v: '8 GB unificada', d: 'SSD de 256 GB o 512 GB (el de 512 GB incluye Touch ID).' },
  { k: 'Diseño', v: '1,23 kg', d: '1,27 × 29,75 × 20,64 cm. Sin ventilador: completamente silenciosa.' },
  { k: 'Conexiones', v: '2 × USB‑C', d: 'Uno USB 3 con salida a monitor, otro USB 2. Jack de audífonos, Wi‑Fi 6E y Bluetooth 6.' },
];
const specsEn = [
  { k: 'Chip', v: 'Apple A18 Pro', d: '6‑core CPU, 5‑core GPU, 16‑core Neural Engine.' },
  { k: 'Display', v: '13" Liquid Retina', d: '2408 × 1506, 500 nits, anti‑reflective coating.' },
  { k: 'Battery', v: 'Up to 16 hours', d: 'A full day of classes without hunting for an outlet.' },
  { k: 'Memory', v: '8 GB unified', d: '256 GB or 512 GB SSD (the 512 GB model includes Touch ID).' },
  { k: 'Design', v: '1.23 kg', d: '1.27 × 29.75 × 20.64 cm. Fanless: completely silent.' },
  { k: 'Ports', v: '2 × USB‑C', d: 'One USB 3 with display output, one USB 2. Headphone jack, Wi‑Fi 6E and Bluetooth 6.' },
];
const t = {
  es: {
    specs: specsEs, eyebrow: 'La máquina', title: 'MacBook Neo. En Blush.',
    lead: 'Lanzada por Apple en marzo de 2026. Con Magic Keyboard a juego con el color del equipo — ese rosa que Silenia lleva tiempo mirando.',
    alt: 'MacBook Neo en Blush vista desde arriba y de perfil',
    link: 'Ver la MacBook Neo en apple.com ›', href: 'https://www.apple.com/co/macbook-neo/',
  },
  en: {
    specs: specsEn, eyebrow: 'The machine', title: 'MacBook Neo. In Blush.',
    lead: 'Launched by Apple in March 2026. With a Magic Keyboard that matches the color — the pink Silenia has had her eye on for a while.',
    alt: 'MacBook Neo in Blush seen from above and from the side',
    link: 'See MacBook Neo on apple.com ›', href: 'https://www.apple.com/macbook-neo/',
  },
}[lang];
const specs = t.specs;
---
<section class="section" id="la-maquina">
  <div class="container">
    <div class="center">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-lead">{t.lead}</p>
    </div>

    <img class="machine__img" src={asset('/img/neo-blush.png')} alt={t.alt} width="1369" height="965" loading="lazy" />

    <dl class="specs">
      {specs.map((s) => (
        <div class="spec">
          <dt>{s.k}</dt>
          <dd><strong>{s.v}</strong>{s.d}</dd>
        </div>
      ))}
    </dl>

    <p class="center machine__link">
      <a href={t.href} target="_blank" rel="noopener">{t.link}</a>
    </p>
  </div>
</section>

<style>
  .machine__img { width: 100%; max-width: 720px; margin: 32px auto 0; }
  .specs {
    margin: 40px 0 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
    border-top: 1px solid var(--line);
  }
  .spec { padding: 20px 18px 20px 0; border-bottom: 1px solid var(--line); }
  .spec dt { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-2); }
  .spec dd { margin: 6px 0 0; color: var(--text-2); font-size: 13px; }
  .spec dd strong { display: block; color: var(--text); font-size: 19px; letter-spacing: -0.03em; margin-bottom: 4px; }
  .machine__link { margin-top: 36px; }
  @media (max-width: 834px) { .specs { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .specs { grid-template-columns: 1fr; } }
</style>

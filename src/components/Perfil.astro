---
import { INSTAGRAM_URL, INSTAGRAM_HANDLE, asset } from '../data/proyecto.js';
import { getLang } from '../i18n.js';

interface Props {
  variant?: 'compact' | 'card';
}
const { variant = 'compact' } = Astro.props;

// Avatar: foto de perfil de Instagram (224×224). No renombrar a silenia.png/.jpg: Historia.astro busca ese nombre para su foto grande.
const AVATAR = '/img/avatar-silenia.jpg';
const NOMBRE = 'Silenia Camargo';
const t = {
  es: {
    sub: 'Soy la futura dueña de esta tapa', igLabel: `Mi Instagram: ${NOMBRE}`,
    cardTitle: 'Quién está detrás',
  },
  en: {
    sub: 'I’m the future owner of this lid', igLabel: `My Instagram: ${NOMBRE}`,
    cardTitle: 'Who’s behind this',
  },
}[getLang(Astro)];
---
{variant === 'compact' ? (
  <div class="perfil">
    <span class="avatar">
      <img src={asset(AVATAR)} alt="" width="44" height="44" />
    </span>
    <div class="perfil__info">
      <p class="perfil__name">{NOMBRE} <a href={INSTAGRAM_URL} target="_blank" rel="noopener">{INSTAGRAM_HANDLE}</a></p>
      <p class="perfil__sub">{t.sub}</p>
    </div>
    <a class="icon-btn" href={INSTAGRAM_URL} target="_blank" rel="noopener" aria-label={t.igLabel}>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><defs><radialGradient id="ig-grad-compact" cx="0.25" cy="1.05" r="1.25"><stop offset="0" stop-color="#feda75"/><stop offset="0.25" stop-color="#fa7e1e"/><stop offset="0.5" stop-color="#d62976"/><stop offset="0.75" stop-color="#962fbf"/><stop offset="1" stop-color="#4f5bd5"/></radialGradient></defs><g fill="none" stroke={`url(#ig-grad-compact)`} stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></g><circle cx="17.3" cy="6.7" r="1.2" fill={`url(#ig-grad-compact)`}/></svg>
    </a>
  </div>
) : (
  <aside class="card">
    <p class="card__title">{t.cardTitle}</p>
    <div class="card__head">
      <span class="avatar avatar--lg">
        <img src={asset(AVATAR)} alt="" width="56" height="56" />
      </span>
      <div>
        <p class="perfil__name">{NOMBRE}</p>
        <a class="card__handle" href={INSTAGRAM_URL} target="_blank" rel="noopener">{INSTAGRAM_HANDLE}</a>
        <a class="pill" href={INSTAGRAM_URL} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><defs><radialGradient id="ig-grad-card" cx="0.25" cy="1.05" r="1.25"><stop offset="0" stop-color="#feda75"/><stop offset="0.25" stop-color="#fa7e1e"/><stop offset="0.5" stop-color="#d62976"/><stop offset="0.75" stop-color="#962fbf"/><stop offset="1" stop-color="#4f5bd5"/></radialGradient></defs><g fill="none" stroke={`url(#ig-grad-card)`} stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></g><circle cx="17.3" cy="6.7" r="1.2" fill={`url(#ig-grad-card)`}/></svg>
          Instagram
        </a>
      </div>
    </div>
  </aside>
)}

<style>
  .avatar {
    flex: none; width: 44px; height: 44px; border-radius: 50%; overflow: hidden;
    display: grid; place-items: center;
    background: linear-gradient(135deg, var(--blush), #d98a9c);
    color: #fff; font-size: 14px; font-weight: 600; letter-spacing: 0.02em;
  }
  .avatar--lg { width: 56px; height: 56px; font-size: 17px; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }

  .perfil { display: inline-flex; align-items: center; gap: 12px; margin-top: 28px; text-align: left; }
  .perfil__info p { margin: 0; }
  .perfil__name { margin: 0; font-size: 15px; font-weight: 600; color: var(--text); }
  .perfil__name a { font-weight: 400; }
  .perfil__sub { font-size: 13px; color: var(--text-2); }
  .icon-btn {
    flex: none; width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center;
    border: 1px solid var(--line);
    transition: border-color .2s, background .2s;
  }
  .icon-btn:hover { border-color: #d62976; background: #fdf2f7; }

  .card {
    margin-top: 28px; padding: 20px 22px;
    border: 1px solid var(--line); border-radius: var(--radius);
  }
  .card__title { margin: 0 0 14px; font-size: 14px; font-weight: 500; color: var(--text); }
  .card__head { display: flex; gap: 14px; align-items: flex-start; }
  .card__head .perfil__name { font-size: 16px; }
  .card__handle { display: block; font-size: 14px; margin-top: 2px; }
  .pill {
    display: inline-flex; align-items: center; gap: 6px; margin-top: 10px;
    padding: 5px 12px; border: 1px solid var(--line); border-radius: 99px;
    font-size: 13px; color: var(--text);
    transition: border-color .2s;
  }
  .pill:hover { border-color: #d62976; text-decoration: none; }
</style>

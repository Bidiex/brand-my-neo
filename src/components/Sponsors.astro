---
import Money from './Money.astro';
import { vendidos, asset, nombreSpot } from '../data/proyecto.js';
import { getLang } from '../i18n.js';

const lang = getLang(Astro);
const t = {
  es: { eyebrow: 'Auspiciadores', title: 'Quienes ya están en la tapa.', empty: 'Todavía no hay nadie aquí.<br />El primer logo en la tapa puede ser el tuyo.', cta: 'Consigue un spot' },
  en: { eyebrow: 'Sponsors', title: 'Already on the lid.', empty: 'Nobody here yet.<br />The first logo on the lid could be yours.', cta: 'Get a spot' },
}[lang];
---
<section class="section" id="auspiciadores">
  <div class="container center">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 class="section-title">{t.title}</h2>

    {vendidos.length === 0 ? (
      <div class="empty">
        <p set:html={t.empty} />
        <a class="btn" href="#spots">{t.cta}</a>
      </div>
    ) : (
      <ul class="sponsors">
        {vendidos.map((s) => {
          const Tag = s.linkUrl ? 'a' : 'div';
          return (
            <li>
              <Tag class="sponsor" href={s.linkUrl || undefined} target={s.linkUrl ? '_blank' : undefined} rel={s.linkUrl ? 'noopener sponsored' : undefined}>
                <div class="sponsor__logo">
                  {s.logoUrl ? <img src={asset(s.logoUrl)} alt={s.nombreAuspiciador} loading="lazy" /> : <span>{s.nombreAuspiciador}</span>}
                </div>
                <strong>{s.nombreAuspiciador}</strong>
                <span class="sponsor__meta">{nombreSpot(s, lang)} · <Money value={s.precio} /></span>
              </Tag>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>

<style>
  .empty {
    margin: 44px auto 0; max-width: 520px; padding: 44px 28px;
    border: 1.5px dashed var(--blush); border-radius: 24px;
  }
  .empty p { font-size: 16px; color: var(--text-2); margin: 0 0 22px; }

  .sponsors {
    list-style: none; padding: 0; margin: 48px 0 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 18px;
  }
  .sponsor {
    display: flex; flex-direction: column; align-items: center; gap: 6px; height: 100%;
    padding: 22px; border-radius: var(--radius); background: transparent; border: 1px solid var(--line); color: var(--text);
    transition: transform .2s;
  }
  a.sponsor:hover { text-decoration: none; transform: translateY(-3px); }
  .sponsor__logo { height: 80px; width: 100%; display: grid; place-items: center; margin-bottom: 8px; }
  .sponsor__logo img { max-height: 80px; max-width: 100%; object-fit: contain; }
  .sponsor__logo span { font-weight: 600; font-size: 18px; }
  .sponsor__meta { font-size: 12px; color: var(--text-2); }
</style>

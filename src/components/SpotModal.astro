---
import { NEQUI } from '../data/proyecto.js';
import { getLang } from '../i18n.js';

const lang = getLang(Astro);
const t = {
  es: {
    close: 'Cerrar', eyebrow: 'Reservar spot', usdNote: 'el pago es en COP',
    pay: 'Paga por Nequi', send1: 'Envía', send2: 'al número:', copy: 'Copiar',
    keep: 'Guarda la captura del comprobante: la necesitas abajo.',
    details: 'Envía tus datos', brand: 'Nombre o marca', link: 'Link de tu sitio o red social', email: 'Email de contacto',
    receipt: 'Comprobante de pago Nequi', receiptHint: 'Captura de pantalla (JPG o PNG)',
    logo: 'Tu logo', logoHint: 'PNG o SVG con fondo transparente',
    choose: 'Elegir archivo', chooseShort: 'Elegir',
    accept: 'Entiendo que cada logo se aprueba manualmente y que el pago no se reembolsa automáticamente.', terms: 'Ver condiciones',
    submit: 'Enviar reserva',
    doneTitle: '¡Recibido!',
    done: 'Reviso tu comprobante y te escribo al email en cuanto confirme el pago. Cuando esté aprobado, tu logo aparece en la tapa de esta página y el sticker va a la MacBook de Silenia.',
    thanks: 'Gracias por ser parte de esto.',
  },
  en: {
    close: 'Close', eyebrow: 'Reserve a spot', usdNote: 'payment is in COP',
    pay: 'Pay with Nequi', send1: 'Send', send2: 'to this Nequi number:', copy: 'Copy',
    keep: 'Save a screenshot of the receipt: you’ll need it below.',
    details: 'Send your details', brand: 'Name or brand', link: 'Link to your website or social profile', email: 'Contact email',
    receipt: 'Nequi payment receipt', receiptHint: 'Screenshot (JPG or PNG)',
    logo: 'Your logo', logoHint: 'PNG or SVG with a transparent background',
    choose: 'Choose file', chooseShort: 'Choose',
    accept: 'I understand that every logo is approved manually and that the payment isn’t refunded automatically.', terms: 'See terms',
    submit: 'Send reservation',
    doneTitle: 'Got it!',
    done: 'I’ll check your receipt and email you as soon as I confirm the payment. Once it’s approved, your logo shows up on the lid on this page and the sticker goes on Silenia’s MacBook.',
    thanks: 'Thanks for being part of this.',
  },
}[lang];

// Textos que usa el script del cliente
const js = {
  es: {
    copied: 'Copiado', copy: 'Copiar', change: 'Cambiar', choose: 'Elegir', sending: 'Enviando…', submit: 'Enviar reserva',
    errFiles: 'Adjunta los dos archivos.', errFields: 'Revisa los campos marcados.',
    errSize: 'Los archivos pesan demasiado (máx. 5 MB entre los dos). Prueba con imágenes más livianas.',
    errInactive: 'El formulario todavía no está activo. Vuelve a intentarlo pronto.',
    errSend: 'No se pudo enviar. Intenta de nuevo en un momento.',
  },
  en: {
    copied: 'Copied', copy: 'Copy', change: 'Change', choose: 'Choose', sending: 'Sending…', submit: 'Send reservation',
    errFiles: 'Please attach both files.', errFields: 'Please check the highlighted fields.',
    errSize: 'The files are too large (5 MB max for both). Try lighter images.',
    errInactive: 'The form isn’t active yet. Please try again soon.',
    errSend: 'Couldn’t send it. Please try again in a moment.',
  },
}[lang];
---
<dialog class="modal" id="spot-dialog" aria-labelledby="modal-title" data-i18n={JSON.stringify(js)}>
  <button type="button" class="modal__close" data-close aria-label={t.close}>×</button>

  <div class="modal__body" data-view="form">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 id="modal-title" class="modal__title" data-fill="nombre">Spot</h2>
    <p class="modal__price"><span data-fill="precio"></span> COP</p>
    <p class="modal__usd" data-cur="USD">≈ <span data-fill="usd"></span> · {t.usdNote}</p>

    <ol class="steps">
      <li>
        <strong>{t.pay}</strong>
        <p>{t.send1} <b data-fill="precio"></b> COP {t.send2}</p>
        <div class="nequi">
          <span class="nequi__num">{NEQUI.replace(/(\d{3})(\d{3})(\d{4})/, '$1 $2 $3')}</span>
          <button type="button" class="nequi__copy" data-copy={NEQUI}>{t.copy}</button>
        </div>
        <p class="hint">{t.keep}</p>
      </li>
      <li>
        <strong>{t.details}</strong>
        <form class="form" id="spot-form" novalidate>
          <input type="hidden" name="spot_id" />
          <input type="hidden" name="spot" />
          <input type="hidden" name="precio" />
          <input type="hidden" name="idioma" value={lang} />
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

          <label>
            <span>{t.brand}</span>
            <input type="text" name="marca" required maxlength="80" autocomplete="organization" />
          </label>
          <label>
            <span>{t.link}</span>
            <input type="url" name="link" required placeholder="https://" />
          </label>
          <label>
            <span>{t.email}</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          {[
            { name: 'comprobante', label: t.receipt, accept: 'image/*', hint: t.receiptHint },
            { name: 'logo', label: t.logo, accept: 'image/png,image/svg+xml,image/jpeg,image/webp,application/pdf', hint: t.logoHint },
          ].map((f) => (
            <div class="field">
              <span class="field__label" id={`${f.name}-label`}>{f.label}</span>
              <div class="file">
                <!-- el input cubre toda la caja (invisible): clic, teclado y arrastrar-soltar siguen siendo nativos -->
                <input type="file" name={f.name} required accept={f.accept} title="" aria-labelledby={`${f.name}-label`} aria-describedby={`${f.name}-hint`} />
                <span class="file__icon" aria-hidden="true">
                  <svg class="file__up" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5M5 20h14" /></svg>
                  <svg class="file__ok" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                </span>
                <span class="file__text">
                  <span class="file__name" data-empty={t.choose}>{t.choose}</span>
                  <span class="file__hint" id={`${f.name}-hint`}>{f.hint}</span>
                </span>
                <span class="file__action" aria-hidden="true">{t.chooseShort}</span>
              </div>
            </div>
          ))}
          <label class="check">
            <input type="checkbox" name="acepto" required />
            <span>
              {t.accept}
              <a href="#faq">{t.terms}</a>
            </span>
          </label>

          <p class="form__error" role="alert" hidden></p>
          <button type="submit" class="btn form__submit">{t.submit}</button>
        </form>
      </li>
    </ol>
  </div>

  <div class="modal__body modal__done" data-view="done" hidden>
    <div class="done__icon" aria-hidden="true">✓</div>
    <h2 class="modal__title">{t.doneTitle}</h2>
    <p>{t.done}</p>
    <p><strong>{t.thanks}</strong></p>
    <button type="button" class="btn" data-close>{t.close}</button>
  </div>
</dialog>

<script>
  import { formatCOP, formatUSD } from '../scripts/currency.ts';

  // ⚙️ Web3Forms: genera tu Access Key gratis en https://web3forms.com y reemplaza este valor.
  const WEB3FORMS_ACCESS_KEY = 'TU_ACCESS_KEY_AQUI';
  const MAX_TOTAL_BYTES = 5 * 1024 * 1024; // límite total de adjuntos

  const dialog = document.getElementById('spot-dialog') as HTMLDialogElement;
  const form = document.getElementById('spot-form') as HTMLFormElement;
  const errorEl = form.querySelector('.form__error') as HTMLElement;
  const submitBtn = form.querySelector('.form__submit') as HTMLButtonElement;
  const views = {
    form: dialog.querySelector('[data-view="form"]') as HTMLElement,
    done: dialog.querySelector('[data-view="done"]') as HTMLElement,
  };
  const T = JSON.parse(dialog.dataset.i18n!);
  let precioActual = 0;

  function showView(name: 'form' | 'done') {
    views.form.hidden = name !== 'form';
    views.done.hidden = name !== 'done';
  }

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.hidden = !msg;
  }

  function open(btn: HTMLElement) {
    const { spotId = '', spotNombre = '', spotRef = '', spotPrecio = '0' } = btn.dataset;
    precioActual = Number(spotPrecio);
    const precio = formatCOP(precioActual);
    dialog.querySelectorAll('[data-fill="nombre"]').forEach((el) => (el.textContent = spotNombre));
    dialog.querySelectorAll('[data-fill="precio"]').forEach((el) => (el.textContent = precio));
    fillUSD();
    (form.elements.namedItem('spot_id') as HTMLInputElement).value = spotId;
    // el correo llega siempre con el nombre del spot en español
    (form.elements.namedItem('spot') as HTMLInputElement).value = spotRef || spotNombre;
    (form.elements.namedItem('precio') as HTMLInputElement).value = precio + ' COP';
    showError('');
    showView('form');
    dialog.showModal();
  }

  // Equivalente aproximado en USD (solo visible si el visitante eligió USD)
  function fillUSD() {
    dialog.querySelectorAll('[data-fill="usd"]').forEach((el) => (el.textContent = formatUSD(precioActual)));
  }
  document.addEventListener('currencychange', fillUSD);

  document.querySelectorAll<HTMLElement>('[data-spot-id]').forEach((btn) =>
    btn.addEventListener('click', () => open(btn))
  );

  dialog.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    // clic en el backdrop o en un botón de cerrar
    if (target === dialog || target.closest('[data-close]')) dialog.close();
  });

  // Inputs de archivo: mostrar el nombre elegido en la caja personalizada
  const fileInputs = form.querySelectorAll<HTMLInputElement>('.file input[type="file"]');
  function syncFile(input: HTMLInputElement) {
    const box = input.closest('.file') as HTMLElement;
    const name = box.querySelector('.file__name') as HTMLElement;
    const action = box.querySelector('.file__action') as HTMLElement;
    const file = input.files?.[0];
    box.classList.toggle('is-filled', !!file);
    name.textContent = file ? file.name : name.dataset.empty!;
    action.textContent = file ? T.change : T.choose;
  }
  fileInputs.forEach((input) => input.addEventListener('change', () => syncFile(input)));
  // form.reset() no dispara 'change': re-sincronizar después de que el reset termine
  form.addEventListener('reset', () => setTimeout(() => fileInputs.forEach(syncFile)));

  dialog.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      btn.textContent = T.copied;
      setTimeout(() => (btn.textContent = T.copy), 1800);
    } catch {
      /* el número sigue visible para copiarlo a mano */
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    showError('');

    if (!form.checkValidity()) {
      const invalid = form.querySelector(':invalid') as HTMLInputElement | null;
      invalid?.focus();
      showError(invalid?.type === 'file' ? T.errFiles : T.errFields);
      return;
    }

    const files = ['comprobante', 'logo'].map((n) => (form.elements.namedItem(n) as HTMLInputElement).files![0]);
    if (files.reduce((t, f) => t + f.size, 0) > MAX_TOTAL_BYTES) {
      showError(T.errSize);
      return;
    }

    if (WEB3FORMS_ACCESS_KEY === 'TU_ACCESS_KEY_AQUI') {
      showError(T.errInactive);
      return;
    }

    const data = new FormData(form);
    data.append('access_key', WEB3FORMS_ACCESS_KEY);
    data.append('subject', `Brand My Neo — Reserva ${data.get('spot')} (${data.get('precio')})`);
    data.append('from_name', 'Brand My Neo');
    data.set('acepto', 'Sí');

    submitBtn.disabled = true;
    submitBtn.textContent = T.sending;
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      const json = await res.json();
      if (!json.success) throw new Error(json.message);
      form.reset();
      showView('done');
    } catch (err) {
      showError(T.errSend + (err instanceof Error && err.message ? ` (${err.message})` : ''));
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = T.submit;
    }
  });
</script>

<style>
  .modal {
    width: min(560px, calc(100% - 24px));
    max-height: calc(100dvh - 24px);
    padding: 0; border: 0; border-radius: 24px;
    color: var(--text);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.3);
  }
  /* Bloquea el scroll de la página mientras el modal está abierto (el gutter evita el salto al ocultar la barra) */
  :global(html:has(#spot-dialog[open])) { overflow: hidden; scrollbar-gutter: stable; }
  .modal { overscroll-behavior: contain; }
  .modal::backdrop { background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(6px); }
  .modal[open] { animation: pop .25s ease-out; }
  @keyframes pop { from { opacity: 0; transform: translateY(12px) scale(.98); } }

  .modal__body { padding: 36px 32px 32px; }
  .modal__close {
    position: sticky; top: 12px; float: right; margin: 12px 12px 0 0;
    width: 32px; height: 32px; border-radius: 50%; border: 0;
    background: var(--bg-alt); color: var(--text-2); font-size: 22px; line-height: 1; cursor: pointer;
  }
  .modal__title { font-size: 23px; }
  .modal__price { font-size: 18px; color: var(--rose); font-weight: 600; margin: 6px 0 0; }
  .modal__usd { margin: 2px 0 0; font-size: 13px; color: var(--text-2); }

  .steps { margin: 28px 0 0; padding: 0; list-style: none; counter-reset: step; }
  /* El número va en línea con el título del paso; el contenido usa todo el ancho (sin sangría) */
  .steps > li { counter-increment: step; position: relative; margin-bottom: 28px; }
  .steps > li::before {
    content: counter(step); position: absolute; left: 0; top: 0;
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--blush-soft); color: var(--rose); font-weight: 600; font-size: 15px;
    display: grid; place-items: center;
  }
  .steps > li > strong { display: block; padding-left: 38px; font-size: 16px; line-height: 28px; }
  .steps > li > p:first-of-type { margin-top: 10px; }
  .steps p { margin: 6px 0 0; color: var(--text-2); font-size: 14px; }
  .steps .hint { font-size: 13px; }

  .nequi {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px;
    margin-top: 10px; padding: 12px 16px; border-radius: 14px; background: var(--bg-alt);
  }
  .nequi__num { font-size: 19px; font-weight: 600; letter-spacing: 0.02em; font-variant-numeric: tabular-nums; }
  .nequi__copy {
    border: 0; background: #fff; color: var(--rose); font: inherit; font-size: 14px; font-weight: 500;
    padding: 6px 14px; border-radius: 99px; cursor: pointer;
  }

  /* minmax(0, 1fr) + min-width: 0: sin esto, el ancho intrínseco de los input de archivo ensancha el modal en mobile */
  .form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 14px; }
  .form label { display: grid; gap: 6px; min-width: 0; font-size: 14px; font-weight: 500; }
  .form input { min-width: 0; max-width: 100%; }
  .form label em { font-style: normal; font-weight: 400; color: var(--text-2); }
  .form input[type="text"], .form input[type="url"], .form input[type="email"] {
    font: inherit; font-size: 16px; padding: 11px 14px;
    border: 1px solid var(--line); border-radius: 12px; background: #fff; color: var(--text);
  }
  .form input:focus { border-color: var(--rose); outline: none; box-shadow: 0 0 0 3px rgba(180, 84, 106, 0.15); }
  .field { display: grid; gap: 6px; min-width: 0; }
  .field__label { font-size: 14px; font-weight: 500; }

  .file {
    position: relative; display: flex; align-items: center; gap: 12px; min-width: 0;
    padding: 12px 14px; border: 1px dashed var(--line); border-radius: 14px; background: var(--bg-alt);
    transition: border-color .15s, background .15s, box-shadow .15s;
  }
  .file input[type="file"] {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; cursor: pointer; font-size: 0;
  }
  .file:hover { border-color: var(--rose); background: var(--blush-soft); }
  .file:focus-within { border-color: var(--rose); box-shadow: 0 0 0 3px rgba(180, 84, 106, 0.15); }
  .file__icon {
    flex: none; display: grid; place-items: center; width: 38px; height: 38px;
    border-radius: 10px; background: #fff; color: var(--rose);
  }
  .file__text { display: grid; min-width: 0; flex: 1; line-height: 1.3; }
  .file__name { font-size: 14px; font-weight: 500; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .file__hint { font-size: 12px; color: var(--text-2); }
  .file__action {
    flex: none; font-size: 13px; font-weight: 500; color: var(--rose);
    background: #fff; padding: 6px 12px; border-radius: 99px;
  }
  .file.is-filled { border-style: solid; border-color: rgba(47, 138, 79, 0.45); background: #f1f8f3; }
  .file__ok, .file.is-filled .file__up { display: none; }
  .file.is-filled .file__ok { display: block; }
  .file.is-filled .file__icon { color: var(--ok); }
  .file.is-filled .file__hint { display: none; }
  .form .check { grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 10px; font-weight: 400; color: var(--text-2); }
  .form .check input { margin-top: 3px; accent-color: var(--rose); }
  .form__error { margin: 0; color: #c0392b; font-size: 14px; }
  .form__submit { width: 100%; margin-top: 4px; }

  .modal__done { text-align: center; }
  .modal__done p { color: var(--text-2); }
  .done__icon {
    width: 56px; height: 56px; margin: 0 auto 18px; border-radius: 50%;
    display: grid; place-items: center; font-size: 28px; color: #fff; background: var(--ok);
  }

  @media (max-width: 480px) {
    .modal__body { padding: 28px 20px 24px; }
    /* en mobile toda la caja es el botón: el pill "Elegir/Cambiar" solo le quita espacio al nombre */
    .file { padding: 10px 12px; gap: 10px; }
    .file__action { display: none; }
  }
</style>

---
import Money from './Money.astro';
import { spots, cop, asset, nombreSpot } from '../data/proyecto.js';
import { getLang } from '../i18n.js';

const lang = getLang(Astro);
const t = {
  es: {
    hint: 'Toca un espacio libre para reservarlo. Tu logo se imprime como sticker y se pega en la MacBook Neo real de Silenia.',
    alt: 'Tapa de la MacBook Neo en color Blush',
    available: 'Disponible', availableAria: 'disponible',
    tiers: {
      superior: ['Fila superior', '3 spots grandes, lo primero que se ve al abrir la mochila.'],
      media: ['Fila media', '4 spots flanqueando el logo, justo en el centro de la tapa.'],
      inferior: ['Fila inferior', '3 spots grandes, cerca de la bisagra.'],
    },
    stock: (libres, total) => `${libres} de ${total} disponibles`, soldOut: 'Agotado',
    noteCOP: 'Precios en pesos colombianos (COP).',
    noteUSD: 'Precios aproximados en dólares; el pago se hace en pesos colombianos (COP).',
    noteLogo: 'El logo de Apple queda libre: no se vende.',
  },
  en: {
    hint: 'Tap a free spot to reserve it. Your logo is printed as a sticker and placed on Silenia’s real MacBook Neo.',
    alt: 'MacBook Neo lid in Blush',
    available: 'Available', availableAria: 'available',
    tiers: {
      superior: ['Top row', '3 large spots, the first thing you see when it comes out of the backpack.'],
      media: ['Middle row', '4 spots flanking the logo, right in the center of the lid.'],
      inferior: ['Bottom row', '3 large spots, close to the hinge.'],
    },
    stock: (libres, total) => `${libres} of ${total} available`, soldOut: 'Sold out',
    noteCOP: 'Prices in Colombian pesos (COP).',
    noteUSD: 'Approximate prices in US dollars; payment is made in Colombian pesos (COP).',
    noteLogo: 'The Apple logo stays clear: it’s not for sale.',
  },
}[lang];

const pos = (r) => `left:${r.left}%;top:${r.top}%;width:${r.width}%;height:${r.height}%`;

const niveles = ['superior', 'media', 'inferior'].map((fila) => ({ fila, titulo: t.tiers[fila][0], desc: t.tiers[fila][1] })).map((n) => {
  const deFila = spots.filter((s) => s.fila === n.fila);
  return { ...n, precio: deFila[0].precio, total: deFila.length, libres: deFila.filter((s) => !s.vendido).length };
});
---
<section class="spots" id="spots">
  <div class="container">
    <p class="spots__hint center">
      {t.hint}
    </p>

    <div class="lid-wrap">
      <div class="lid">
        <img class="lid__img" src={asset('/img/neo-lid.png')} alt={t.alt} width="1369" height="965" />

        {spots.map((s) =>
          s.vendido ? (
            <a
              class="spot spot--sold"
              style={pos(s.rect)}
              href={s.linkUrl || undefined}
              target="_blank"
              rel="noopener sponsored"
              aria-label={`${nombreSpot(s, lang)}: ${s.nombreAuspiciador}`}
            >
              {s.logoUrl ? <img src={asset(s.logoUrl)} alt="" loading="lazy" /> : <span class="spot__name">{s.nombreAuspiciador}</span>}
              <span class="spot__tip">{s.nombreAuspiciador}</span>
            </a>
          ) : (
            <button
              type="button"
              class="spot"
              style={pos(s.rect)}
              data-spot-id={s.id}
              data-spot-nombre={nombreSpot(s, lang)}
              data-spot-ref={s.nombre}
              data-spot-precio={s.precio}
              aria-label={`${nombreSpot(s, lang)}, ${cop(s.precio)} COP, ${t.availableAria}`}
            >
              <span class="spot__price"><Money value={s.precio} /></span>
              <span class="spot__state">{t.available}</span>
            </button>
          )
        )}
      </div>
    </div>

    <ul class="tiers">
      {niveles.map((n) => (
        <li class="tier">
          <div class="tier__head">
            <h3>{n.titulo}</h3>
            <span class="tier__price"><Money value={n.precio} /></span>
          </div>
          <p>{n.desc}</p>
          <p class="tier__stock">
            {n.libres > 0 ? t.stock(n.libres, n.total) : t.soldOut}
          </p>
        </li>
      ))}
    </ul>
    <p class="note center"><span data-cur="COP">{t.noteCOP}</span><span data-cur="USD">{t.noteUSD}</span> {t.noteLogo}</p>
  </div>
</section>

<style>
  .spots { padding: 28px 0 80px; }
  .spots__hint { max-width: 520px; margin: 0 auto; font-size: 14px; color: var(--text-2); }
  .lid-wrap { max-width: 920px; margin: 20px auto 0; }
  .lid {
    position: relative;
    container-type: inline-size;
    background: transparent;
    user-select: none;
  }
  .lid__img { width: 100%; height: auto; }

  .spot {
    position: absolute;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.3cqw;
    padding: 0; margin: 0;
    font: inherit; color: var(--rose);
    background: rgba(255, 255, 255, 0.16);
    border: max(1px, 0.18cqw) dashed rgba(180, 84, 106, 0.5);
    border-radius: 1.4cqw;
    cursor: pointer;
    transition: background .2s, border-color .2s, transform .2s, box-shadow .2s;
  }
  .spot:hover, .spot:focus-visible {
    background: rgba(255, 255, 255, 0.62);
    border-style: solid; border-color: var(--rose);
    transform: translateY(-0.3cqw);
    box-shadow: 0 1.2cqw 2.6cqw -1cqw rgba(120, 50, 65, 0.4);
    z-index: 2;
    outline: none;
  }
  .spot__price { font-weight: 600; font-size: clamp(9px, 1.9cqw, 18px); letter-spacing: -0.02em; line-height: 1; }
  .spot__state { font-size: clamp(7px, 1.1cqw, 11px); text-transform: uppercase; letter-spacing: 0.08em; opacity: .75; line-height: 1; }

  .spot--sold {
    background: rgba(255, 255, 255, 0.9);
    border: 0;
    box-shadow: 0 0.4cqw 1.2cqw rgba(0, 0, 0, 0.12);
    padding: 1.2cqw;
    color: var(--text);
    cursor: default;
  }
  .spot--sold[href] { cursor: pointer; }
  .spot--sold:hover { text-decoration: none; }
  .spot--sold img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .spot__name { font-weight: 600; font-size: clamp(9px, 2cqw, 20px); text-align: center; }
  .spot__tip {
    position: absolute; bottom: calc(100% + 0.8cqw); left: 50%; transform: translateX(-50%);
    background: var(--text); color: #fff; font-size: 12px; white-space: nowrap;
    padding: 4px 10px; border-radius: 8px; pointer-events: none;
    opacity: 0; transition: opacity .15s;
  }
  .spot--sold:hover .spot__tip, .spot--sold:focus-visible .spot__tip { opacity: 1; }

  .tiers {
    list-style: none; padding: 0; margin: 40px 0 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;
  }
  .tier { background: var(--bg-alt); border-radius: var(--radius); padding: 18px 20px; }
  .tier__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .tier h3 { font-size: 16px; letter-spacing: -0.02em; }
  .tier__price { font-weight: 600; color: var(--rose); }
  .tier p { margin: 8px 0 0; color: var(--text-2); font-size: 13px; }
  .tier .tier__stock { color: var(--text); font-weight: 500; }
  .note { margin-top: 18px; color: var(--text-2); font-size: 12px; }

  @media (max-width: 834px) {
    .tiers { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .spot__state { display: none; }
  }
</style>
